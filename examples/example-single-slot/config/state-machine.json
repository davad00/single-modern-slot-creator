{
  "states": [
    "boot", "loading", "ready", "round_requested", "outcome_received", "outcome_committed",
    "presenting_initial_result", "presenting_wins", "presenting_cascades", "feature_pending",
    "feature_entry", "feature_active", "super_feature_entry", "super_feature_active",
    "ultimate_feature_entry", "ultimate_feature_active", "feature_retrigger", "maximum_win",
    "feature_summary", "round_complete", "reconnecting", "recovering", "error"
  ],
  "transitions": [
    { "from": "boot", "to": "loading", "event": "boot_complete", "guards": [] },
    { "from": "loading", "to": "ready", "event": "load_complete", "guards": [] },
    { "from": "loading", "to": "error", "event": "load_failed", "guards": [] },
    { "from": "ready", "to": "round_requested", "event": "spin_pressed", "guards": ["bet_valid", "round_duration_gate_open"] },
    { "from": "round_requested", "to": "outcome_received", "event": "outcome_fetched", "guards": [] },
    { "from": "round_requested", "to": "reconnecting", "event": "connection_lost", "guards": [] },
    { "from": "outcome_received", "to": "outcome_committed", "event": "outcome_persisted", "guards": ["manifest_signature_valid"] },
    { "from": "outcome_received", "to": "error", "event": "manifest_invalid", "guards": [] },
    { "from": "outcome_committed", "to": "presenting_initial_result", "event": "presentation_started", "guards": [] },
    { "from": "presenting_initial_result", "to": "presenting_wins", "event": "initial_presented", "guards": ["has_initial_wins"] },
    { "from": "presenting_initial_result", "to": "feature_pending", "event": "initial_presented", "guards": ["has_feature_trigger", "no_initial_wins"] },
    { "from": "presenting_initial_result", "to": "round_complete", "event": "initial_presented", "guards": ["no_initial_wins", "no_feature_trigger", "no_pending_cascades"] },
    { "from": "presenting_wins", "to": "presenting_cascades", "event": "wins_presented", "guards": ["has_pending_cascades"] },
    { "from": "presenting_wins", "to": "feature_pending", "event": "wins_presented", "guards": ["has_feature_trigger", "no_pending_cascades"] },
    { "from": "presenting_wins", "to": "maximum_win", "event": "wins_presented", "guards": ["max_win_committed"] },
    { "from": "presenting_wins", "to": "round_complete", "event": "wins_presented", "guards": ["no_feature_trigger", "no_pending_cascades"] },
    { "from": "presenting_cascades", "to": "presenting_wins", "event": "cascade_presented", "guards": ["cascade_produced_wins"] },
    { "from": "presenting_cascades", "to": "feature_pending", "event": "cascades_done", "guards": ["has_feature_trigger"] },
    { "from": "presenting_cascades", "to": "maximum_win", "event": "cascades_done", "guards": ["max_win_committed"] },
    { "from": "presenting_cascades", "to": "round_complete", "event": "cascades_done", "guards": ["no_feature_trigger"] },
    { "from": "feature_pending", "to": "feature_entry", "event": "tier_resolved", "guards": ["tier_is_feature"] },
    { "from": "feature_pending", "to": "super_feature_entry", "event": "tier_resolved", "guards": ["tier_is_super_feature"] },
    { "from": "feature_pending", "to": "ultimate_feature_entry", "event": "tier_resolved", "guards": ["tier_is_ultimate_feature"] },
    { "from": "feature_entry", "to": "feature_active", "event": "entry_presented", "guards": [] },
    { "from": "super_feature_entry", "to": "super_feature_active", "event": "entry_presented", "guards": [] },
    { "from": "ultimate_feature_entry", "to": "ultimate_feature_active", "event": "entry_presented", "guards": [] },
    { "from": "feature_active", "to": "feature_retrigger", "event": "retrigger_step", "guards": ["retrigger_committed"] },
    { "from": "super_feature_active", "to": "feature_retrigger", "event": "retrigger_step", "guards": ["retrigger_committed"] },
    { "from": "ultimate_feature_active", "to": "feature_retrigger", "event": "retrigger_step", "guards": ["retrigger_committed"] },
    { "from": "feature_retrigger", "to": "feature_active", "event": "retrigger_presented", "guards": ["tier_is_feature"] },
    { "from": "feature_retrigger", "to": "super_feature_active", "event": "retrigger_presented", "guards": ["tier_is_super_feature"] },
    { "from": "feature_retrigger", "to": "ultimate_feature_active", "event": "retrigger_presented", "guards": ["tier_is_ultimate_feature"] },
    { "from": "feature_active", "to": "maximum_win", "event": "max_win_step", "guards": ["max_win_committed"] },
    { "from": "super_feature_active", "to": "maximum_win", "event": "max_win_step", "guards": ["max_win_committed"] },
    { "from": "ultimate_feature_active", "to": "maximum_win", "event": "max_win_step", "guards": ["max_win_committed"] },
    { "from": "feature_active", "to": "feature_summary", "event": "feature_rounds_done", "guards": [] },
    { "from": "super_feature_active", "to": "feature_summary", "event": "feature_rounds_done", "guards": [] },
    { "from": "ultimate_feature_active", "to": "feature_summary", "event": "feature_rounds_done", "guards": [] },
    { "from": "maximum_win", "to": "feature_summary", "event": "maxwin_presented", "guards": ["feature_was_active"] },
    { "from": "maximum_win", "to": "round_complete", "event": "maxwin_presented", "guards": ["no_feature_active"] },
    { "from": "feature_summary", "to": "round_complete", "event": "summary_acknowledged", "guards": [] },
    { "from": "round_complete", "to": "ready", "event": "round_settled", "guards": [] },
    { "from": "presenting_initial_result", "to": "reconnecting", "event": "connection_lost", "guards": [] },
    { "from": "presenting_wins", "to": "reconnecting", "event": "connection_lost", "guards": [] },
    { "from": "presenting_cascades", "to": "reconnecting", "event": "connection_lost", "guards": [] },
    { "from": "feature_active", "to": "reconnecting", "event": "connection_lost", "guards": [] },
    { "from": "super_feature_active", "to": "reconnecting", "event": "connection_lost", "guards": [] },
    { "from": "ultimate_feature_active", "to": "reconnecting", "event": "connection_lost", "guards": [] },
    { "from": "reconnecting", "to": "recovering", "event": "connection_restored", "guards": [] },
    { "from": "reconnecting", "to": "error", "event": "reconnect_timeout", "guards": [] },
    { "from": "recovering", "to": "ready", "event": "recovery_done", "guards": ["no_open_round"] },
    { "from": "recovering", "to": "presenting_initial_result", "event": "recovery_done", "guards": ["resume_pointer_in_base"] },
    { "from": "recovering", "to": "feature_active", "event": "recovery_done", "guards": ["resume_pointer_in_feature", "tier_is_feature"] },
    { "from": "recovering", "to": "super_feature_active", "event": "recovery_done", "guards": ["resume_pointer_in_feature", "tier_is_super_feature"] },
    { "from": "recovering", "to": "ultimate_feature_active", "event": "recovery_done", "guards": ["resume_pointer_in_feature", "tier_is_ultimate_feature"] }
  ],
  "guards": [
    { "id": "bet_valid", "description": "Selected bet is a member of betLevelsMinor, within the active jurisdiction maxStakeMinor, and balance >= bet." },
    { "id": "round_duration_gate_open", "description": "max(presentationTime, jurisdiction minimumRoundDurationMs) has elapsed since round_requested of the previous round, and the start control was released and re-pressed where required." },
    { "id": "manifest_signature_valid", "description": "The outcome manifest signature verifies and configHash/gameVersion/mathVersion match the loaded build." },
    { "id": "has_initial_wins", "description": "The committed initial_result step has a non-empty wins array or a scatter pay." },
    { "id": "no_initial_wins", "description": "The committed initial_result step has no wins and no scatter pay." },
    { "id": "has_pending_cascades", "description": "The committed manifest contains unpresented cascade steps." },
    { "id": "no_pending_cascades", "description": "No unpresented cascade steps remain in the committed manifest." },
    { "id": "cascade_produced_wins", "description": "The just-presented cascade step has a non-empty wins array." },
    { "id": "has_feature_trigger", "description": "scatterCount in the committed initial grid >= 3 (initial-grid counting rule; cascaded scatters never count)." },
    { "id": "no_feature_trigger", "description": "scatterCount in the committed initial grid < 3." },
    { "id": "tier_is_feature", "description": "Committed feature.tier == 'feature' (exactly 3 scatters)." },
    { "id": "tier_is_super_feature", "description": "Committed feature.tier == 'super_feature' (exactly 4 scatters)." },
    { "id": "tier_is_ultimate_feature", "description": "Committed feature.tier == 'ultimate_feature' (5+ scatters)." },
    { "id": "retrigger_committed", "description": "The next committed step is of type feature_retrigger." },
    { "id": "max_win_committed", "description": "The committed manifest contains a max_win_termination step at the current position (maximumWinReached true)." },
    { "id": "feature_was_active", "description": "The max-win step occurred inside a feature tier (summary screen still owed)." },
    { "id": "no_feature_active", "description": "The max-win step occurred in the base game." },
    { "id": "no_open_round", "description": "The RGS reports no incomplete round for this session." },
    { "id": "resume_pointer_in_base", "description": "resumePointer references a base-game step (initial_result/cascade/settlement)." },
    { "id": "resume_pointer_in_feature", "description": "resumePointer references a feature step (feature_round/feature_retrigger/max_win_termination)." }
  ],
  "actions": [
    { "id": "lock_spin_button", "description": "Disable the spin control and show the in-flight state.", "onEntryOf": "round_requested" },
    { "id": "debit_wager", "description": "Reflect the server wallet debit (wagerMinor) in the HUD balance; the debit itself is server-side.", "onEntryOf": "round_requested" },
    { "id": "persist_resume_pointer", "description": "Persist roundId + resumePointer so an interrupted presentation can seek instantly on recovery.", "onEntryOf": "outcome_committed" },
    { "id": "unlock_spin_button", "description": "Re-enable the spin control once settlement and the minimum round duration gate allow it.", "onEntryOf": "ready" },
    { "id": "credit_settlement", "description": "Reflect the server settlement credit (totalWinMinor) in the HUD balance and update the net-position display.", "onEntryOf": "round_complete" },
    { "id": "enter_tier_world", "description": "Swap environment layers, lighting and music to the committed tier's world (feature/super_feature/ultimate_feature).", "onEntryOf": "feature_pending" },
    { "id": "exit_tier_world", "description": "Restore the base-game environment and music after the feature summary.", "onExitOf": "feature_summary" },
    { "id": "show_reconnect_overlay", "description": "Blocking non-interactive overlay while the connection is re-established; never hints at the pending result.", "onEntryOf": "reconnecting" },
    { "id": "seek_to_resume_pointer", "description": "Re-fetch the committed manifest and seek presentation to resumePointer instantly (never re-randomize).", "onEntryOf": "recovering" },
    { "id": "freeze_autoplay", "description": "Stop any autoplay session on error, reconnect, feature trigger, or max win.", "onEntryOf": "error" }
  ],
  "recoveryRules": [
    { "state": "boot", "resumable": false, "resumeTo": "boot", "notes": "Cold start; nothing to resume." },
    { "state": "loading", "resumable": false, "resumeTo": "loading", "notes": "Asset load restarts from manifest cache." },
    { "state": "ready", "resumable": false, "resumeTo": "ready", "notes": "No open round; reload lands on ready after RGS open-round check." },
    { "state": "round_requested", "resumable": true, "resumeTo": "recovering", "notes": "If the wager was debited, the RGS resolves the round server-side; recovery fetches the committed manifest and replays it." },
    { "state": "outcome_received", "resumable": true, "resumeTo": "recovering", "notes": "Manifest re-fetched; commit is idempotent by roundId." },
    { "state": "outcome_committed", "resumable": true, "resumeTo": "recovering", "notes": "Replay committed manifest from step-1." },
    { "state": "presenting_initial_result", "resumable": true, "resumeTo": "recovering", "notes": "Seek presentation to resumePointer step instantly." },
    { "state": "presenting_wins", "resumable": true, "resumeTo": "recovering", "notes": "Seek to resumePointer; win values come from the manifest, never recomputed." },
    { "state": "presenting_cascades", "resumable": true, "resumeTo": "recovering", "notes": "Seek to the committed cascade step; grid states are stored per step." },
    { "state": "feature_pending", "resumable": true, "resumeTo": "recovering", "notes": "Tier is committed in the manifest; recovery re-enters the correct tier entry." },
    { "state": "feature_entry", "resumable": true, "resumeTo": "recovering", "notes": "Entry presentation replays or seeks past per animation recoveryPolicy." },
    { "state": "feature_active", "resumable": true, "resumeTo": "recovering", "notes": "remainingRounds/currentMultiplier100/retriggersUsed restored from persisted feature state." },
    { "state": "super_feature_entry", "resumable": true, "resumeTo": "recovering", "notes": "As feature_entry." },
    { "state": "super_feature_active", "resumable": true, "resumeTo": "recovering", "notes": "As feature_active." },
    { "state": "ultimate_feature_entry", "resumable": true, "resumeTo": "recovering", "notes": "As feature_entry." },
    { "state": "ultimate_feature_active", "resumable": true, "resumeTo": "recovering", "notes": "As feature_active." },
    { "state": "feature_retrigger", "resumable": true, "resumeTo": "recovering", "notes": "Retrigger step is committed; presentation seeks to it." },
    { "state": "maximum_win", "resumable": true, "resumeTo": "recovering", "notes": "max_win_termination step replays; total is already capped in the manifest." },
    { "state": "feature_summary", "resumable": true, "resumeTo": "recovering", "notes": "Summary re-shown from committed totals." },
    { "state": "round_complete", "resumable": false, "resumeTo": "ready", "notes": "Round settled; reload lands on ready." },
    { "state": "reconnecting", "resumable": true, "resumeTo": "recovering", "notes": "On restore, recovery takes over." },
    { "state": "recovering", "resumable": true, "resumeTo": "recovering", "notes": "Recovery is idempotent; repeated interruptions restart it." },
    { "state": "error", "resumable": false, "resumeTo": "error", "notes": "Terminal until operator/session recovery; no round state is lost server-side." }
  ],
  "terminalStates": ["round_complete", "error"],
  "invalidTransitionPolicy": "recover",
  "presentationMap": {
    "round_requested": ["anim.reel.spin_start", "anim.ui.button_press"],
    "presenting_initial_result": ["anim.reel.stop", "anim.symbol.land", "anim.scatter.land", "anim.scatter.anticipation"],
    "presenting_wins": ["anim.win.ways", "anim.frame.win_glow", "anim.win.countup", "anim.win.medium", "anim.win.big", "anim.win.mega", "anim.win.epic", "anim.win.max"],
    "presenting_cascades": ["anim.cascade.remove", "anim.cascade.refill", "anim.cascade.multiplier"],
    "feature_pending": ["anim.env.tier_transition"],
    "feature_entry": ["anim.feature.enter"],
    "super_feature_entry": ["anim.super_feature.enter"],
    "ultimate_feature_entry": ["anim.ultimate_feature.enter"],
    "feature_active": ["anim.feature.round"],
    "super_feature_active": ["anim.super_feature.round"],
    "ultimate_feature_active": ["anim.ultimate_feature.round"],
    "feature_retrigger": ["anim.feature.retrigger"],
    "maximum_win": ["anim.maxwin.reached"],
    "feature_summary": ["anim.feature.summary"]
  },
  "audioMap": {
    "boot": ["amb.forge"],
    "ready": ["music.base", "amb.forge"],
    "round_requested": ["sfx.reel.spin_loop", "ui.button_press"],
    "presenting_initial_result": ["sfx.reel.stop", "sfx.scatter.land_1", "sfx.scatter.land_2", "sfx.scatter.land_3", "sfx.scatter.anticipation"],
    "presenting_wins": ["sfx.win.medium", "sfx.win.big", "sfx.win.mega", "sfx.win.epic", "sfx.win.max", "sfx.win.countup_loop", "sfx.win.countup_end", "sfx.result.neutral"],
    "presenting_cascades": ["sfx.cascade.remove", "sfx.cascade.refill", "sfx.cascade.multiplier"],
    "feature_entry": ["sfx.feature.enter"],
    "feature_active": ["music.feature"],
    "super_feature_entry": ["sfx.feature.enter"],
    "super_feature_active": ["music.super_feature"],
    "ultimate_feature_entry": ["sfx.feature.enter"],
    "ultimate_feature_active": ["music.ultimate_feature"],
    "feature_retrigger": ["sfx.feature.retrigger"],
    "maximum_win": ["sfx.win.max"],
    "feature_summary": ["sfx.feature.summary"],
    "error": ["ui.error"]
  }
}
