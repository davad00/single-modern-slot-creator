          "type": "premium_boost",
          "description": "Premium density lift realized by the dedicated feature-strips reel set (authoritative counts in reel-sets.json): premiums rise from ~27% to ~36% of strip positions vs base; lows thinned. Every round also carries the fixed 2x Kindled multiplier (startingMultiplier100 200).",
          "params": {
            "weightMultiplier100": 130,
            "appliesTo": ["H1", "H2", "H3", "H4"],
            "lowWeightMultiplier100": 85
          }
        }
      ],
      "progression": {
        "meter": { "enabled": false, "startValue": 0, "target": 1 },
        "stages": []
      },
      "maxWin": {
        "behavior": "terminate_immediately",
        "celebrationAnimationEventId": "anim.maxwin.reached"
      },
      "recovery": {
        "resumable": true,
        "persistedFields": ["remainingRounds", "currentMultiplier100", "retriggersUsed", "accumulatedWinMinor"]
      },
      "exitSummary": {
        "displayFields": ["total_win", "rounds_played", "retriggers", "max_win_reached"],
        "summaryAnimationEventId": "anim.feature.summary"
