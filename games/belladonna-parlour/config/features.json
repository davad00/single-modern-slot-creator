{
  "features": [
    {
      "tierId": "feature",
      "publicName": "The Tasting",
      "stateMachineRef": "main",
      "reelSetRef": "feature",
      "modifiers": [
        {
          "id": "essence_banking",
          "type": "persistent_multiplier",
          "description": "Distilled Essence banking: each winning feature spin adds the sequence orb sum (drawn from orbTables.feature in the math config) to the master-vial bank; wins pay x bank. Starting bank x1. increment100 is the minimum single-orb increment (x2); actual increments are the drawn orb sums.",
          "params": {
            "startMultiplier100": 100,
            "incrementOn": "any_win",
            "increment100": 200,
            "capMultiplier100": 51200
          }
        }
      ],
      "progression": {
        "meter": { "enabled": false, "startValue": 0, "target": 1 },
        "stages": []
      },
      "maxWin": {
        "behavior": "complete_current_step_then_terminate",
        "celebrationAnimationEventId": "anim.maxwin.reached"
      },
      "recovery": {
        "resumable": true,
        "persistedFields": ["multiplierBank", "spinsLeft", "retriggers"]
      },
      "exitSummary": {
        "displayFields": ["total_win", "rounds_played", "retriggers", "highest_multiplier", "max_win_reached"],
        "summaryAnimationEventId": "anim.feature.summary"
      }
    },
