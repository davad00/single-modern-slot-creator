{
  "states": [
    "boot",
    "loading",
    "ready",
    "round_requested",
    "outcome_received",
    "outcome_committed",
    "presenting_initial_result",
    "presenting_wins",
    "presenting_cascades",
    "feature_pending",
    "feature_entry",
    "feature_active",
    "super_feature_entry",
    "super_feature_active",
    "ultimate_feature_entry",
    "ultimate_feature_active",
    "feature_retrigger",
    "maximum_win",
    "feature_summary",
    "round_complete",
    "reconnecting",
    "recovering",
    "error"
  ],
  "transitions": [
    { "from": "boot", "to": "loading", "event": "boot_complete", "guards": [] },
    { "from": "loading", "to": "ready", "event": "assets_loaded", "guards": [] },
    { "from": "ready", "to": "round_requested", "event": "spin_requested", "guards": [] },
    { "from": "ready", "to": "reconnecting", "event": "connection_lost", "guards": [] },
    { "from": "round_requested", "to": "outcome_received", "event": "outcome_delivered", "guards": [] },
    { "from": "round_requested", "to": "error", "event": "request_failed", "guards": [] },
    { "from": "outcome_received", "to": "outcome_committed", "event": "commit_ack", "guards": [] },
    { "from": "outcome_committed", "to": "presenting_initial_result", "event": "presentation_start", "guards": [] },
    { "from": "presenting_initial_result", "to": "presenting_wins", "event": "initial_presented", "guards": ["has_wins"] },
    { "from": "presenting_initial_result", "to": "presenting_cascades", "event": "initial_presented", "guards": ["has_cascade_step"] },
    { "from": "presenting_initial_result", "to": "feature_pending", "event": "initial_presented", "guards": ["has_feature_trigger", "no_pending_win_steps"] },
    { "from": "presenting_initial_result", "to": "round_complete", "event": "initial_presented", "guards": ["no_wins_no_feature"] },
    { "from": "presenting_wins", "to": "presenting_cascades", "event": "wins_presented", "guards": ["has_cascade_step"] },
    { "from": "presenting_wins", "to": "feature_pending", "event": "wins_presented", "guards": ["has_feature_trigger"] },
    { "from": "presenting_wins", "to": "maximum_win", "event": "wins_presented", "guards": ["max_win_reached"] },
    { "from": "presenting_wins", "to": "round_complete", "event": "wins_presented", "guards": ["no_further_steps"] },
    { "from": "presenting_cascades", "to": "presenting_wins", "event": "cascade_presented", "guards": ["has_new_wins"] },
    { "from": "presenting_cascades", "to": "feature_pending", "event": "cascade_presented", "guards": ["never_cascaded_scatter_trigger"] },
    { "from": "presenting_cascades", "to": "round_complete", "event": "cascade_presented", "guards": ["no_further_steps"] },
    { "from": "feature_pending", "to": "feature_entry", "event": "feature_confirmed", "guards": ["scatters_eq_3"] },
    { "from": "feature_pending", "to": "super_feature_entry", "event": "feature_confirmed", "guards": ["scatters_eq_4"] },
    { "from": "feature_pending", "to": "ultimate_feature_entry", "event": "feature_confirmed", "guards": ["scatters_ge_5"] },
    { "from": "feature_entry", "to": "feature_active", "event": "entry_presented", "guards": [] },
    { "from": "super_feature_entry", "to": "super_feature_active", "event": "entry_presented", "guards": [] },
    { "from": "ultimate_feature_entry", "to": "ultimate_feature_active", "event": "entry_presented", "guards": [] },
    { "from": "feature_active", "to": "feature_retrigger", "event": "retrigger_awarded", "guards": ["retrigger_available"] },
    { "from": "super_feature_active", "to": "feature_retrigger", "event": "retrigger_awarded", "guards": ["retrigger_available"] },
    { "from": "ultimate_feature_active", "to": "feature_retrigger", "event": "retrigger_awarded", "guards": ["retrigger_available"] },
    { "from": "feature_retrigger", "to": "feature_active", "event": "retrigger_presented", "guards": ["tier_is_feature"] },
    { "from": "feature_retrigger", "to": "super_feature_active", "event": "retrigger_presented", "guards": ["tier_is_super_feature"] },
    { "from": "feature_retrigger", "to": "ultimate_feature_active", "event": "retrigger_presented", "guards": ["tier_is_ultimate_feature"] },
    { "from": "feature_active", "to": "maximum_win", "event": "cap_reached", "guards": ["max_win_reached"] },
    { "from": "super_feature_active", "to": "maximum_win", "event": "cap_reached", "guards": ["max_win_reached"] },
    { "from": "ultimate_feature_active", "to": "maximum_win", "event": "cap_reached", "guards": ["max_win_reached"] },
    { "from": "feature_active", "to": "feature_summary", "event": "rounds_exhausted", "guards": ["no_rounds_left"] },
    { "from": "super_feature_active", "to": "feature_summary", "event": "rounds_exhausted", "guards": ["no_rounds_left"] },
    { "from": "ultimate_feature_active", "to": "feature_summary", "event": "rounds_exhausted", "guards": ["no_rounds_left"] },
    { "from": "maximum_win", "to": "feature_summary", "event": "maxwin_presented", "guards": [] },
    { "from": "feature_summary", "to": "round_complete", "event": "summary_dismissed", "guards": [] },
    { "from": "round_complete", "to": "ready", "event": "settlement_confirmed", "guards": ["round_settled"] },
    { "from": "reconnecting", "to": "recovering", "event": "session_restored", "guards": [] },
    { "from": "reconnecting", "to": "error", "event": "recovery_failed", "guards": [] },
    { "from": "recovering", "to": "presenting_initial_result", "event": "recovery_complete", "guards": ["resume_mid_presentation"] },
    { "from": "recovering", "to": "ready", "event": "recovery_complete", "guards": ["round_already_settled"] },
    { "from": "error", "to": "ready", "event": "retry", "guards": [] }
  ],
  "guards": [
    { "id": "has_wins", "description": "The committed manifest step being presented contains wins[] with total > 0." },
    { "id": "has_cascade_step", "description": "The next step in the committed manifest is of type cascade." },
    { "id": "has_feature_trigger", "description": "scatterCount >= 3 on the committed initial grid (initial-grid counting; cascaded scatters never count)." },
    { "id": "no_pending_win_steps", "description": "All win/cascade presentation steps of the paid spin have been presented; feature entry is the next manifest step." },
    { "id": "no_wins_no_feature", "description": "The committed manifest has no wins, no cascade steps and scatterCount < 3." },
    { "id": "no_further_steps", "description": "No unpresented steps remain in the committed manifest for this round segment." },
    { "id": "has_new_wins", "description": "The cascade refill produced a new win set in the next committed step." },
    { "id": "never_cascaded_scatter_trigger", "description": "ALWAYS FALSE by design: countingRule is initial-grid, so scatters landing during cascades can never trigger a feature. This transition is declared only to document the GDD section 19 edge explicitly; it can never fire." },
    { "id": "scatters_eq_3", "description": "Committed initial-grid scatterCount == 3." },
    { "id": "scatters_eq_4", "description": "Committed initial-grid scatterCount == 4." },
    { "id": "scatters_ge_5", "description": "Committed initial-grid scatterCount >= 5 (fiveOrMoreUsesUltimateTier)." },
    { "id": "retrigger_available", "description": "The committed feature_retrigger step exists: 3+ scatters on the feature spin's initial drop AND the tier's retrigger cap (3/4/5) not yet reached." },
    { "id": "tier_is_feature", "description": "Active tier in committed round state is feature." },
    { "id": "tier_is_super_feature", "description": "Active tier in committed round state is super_feature." },
    { "id": "tier_is_ultimate_feature", "description": "Active tier in committed round state is ultimate_feature." },
    { "id": "max_win_reached", "description": "Cumulative round win in the committed manifest equals maxWinXBet x bet (a max_win_termination step is present)." },
    { "id": "no_rounds_left", "description": "spinsLeft == 0 in the committed round state and no retrigger step follows." },
    { "id": "round_settled", "description": "Server acknowledged settlement of the round (balanceAfterMinor confirmed)." },
    { "id": "resume_mid_presentation", "description": "The re-fetched committed manifest carries a resumePointer into presentation/feature steps." },
    { "id": "round_already_settled", "description": "The re-fetched round is fully settled server-side; nothing to replay." }
  ],
  "actions": [
    { "id": "lock_spin_input", "description": "Disable spin/bet/buy controls and start the jurisdiction minimum-round-duration timer.", "onEntryOf": "round_requested" },
    { "id": "unlock_spin_input", "description": "Re-enable spin/bet controls; release-and-re-press required where the active policy demands it.", "onEntryOf": "ready" },
    { "id": "verify_manifest_signature", "description": "Verify the outcome manifest signature before commit; failure routes to error.", "onEntryOf": "outcome_received" },
    { "id": "persist_resume_pointer", "description": "Persist the committed manifest id and resumePointer so any interruption replays from committed data.", "onEntryOf": "outcome_committed" },
    { "id": "stop_autoplay_on_trigger", "description": "Stop any active autoplay session (tier trigger is a mandatory stop condition).", "onEntryOf": "feature_pending" },
    { "id": "show_feature_hud", "description": "Show master-vial (bank) display and spins-left counter for The Tasting.", "onEntryOf": "feature_entry" },
    { "id": "show_super_feature_hud", "description": "Show master-vial display, spins-left counter and distillery pressure dial for The Distillery.", "onEntryOf": "super_feature_entry" },
    { "id": "show_ultimate_feature_hud", "description": "Show master-vial display, spins-left counter and prism rail for The Night Garden.", "onEntryOf": "ultimate_feature_entry" },
    { "id": "hide_feature_hud", "description": "Remove feature HUD elements and restore base-game HUD.", "onExitOf": "feature_summary" },
    { "id": "forfeit_remaining_rounds", "description": "Mark remaining feature rounds forfeited per max-win termination; summary states it explicitly.", "onEntryOf": "maximum_win" },
    { "id": "ack_settlement", "description": "ACK settlement to the RGS (roundId + final stepId) and update the balance display from balanceAfterMinor.", "onEntryOf": "round_complete" },
    { "id": "fetch_committed_round", "description": "GET the latest committed manifest + resumePointer; never re-randomize.", "onEntryOf": "recovering" },
    { "id": "show_error_dialog", "description": "Show a neutral error dialog with retry; no outcome values are displayed until recovery.", "onEntryOf": "error" }
  ],
  "recoveryRules": [
    { "state": "ready", "resumable": false, "resumeTo": "ready", "notes": "No round in flight; reconnect returns to idle." },
    { "state": "round_requested", "resumable": false, "resumeTo": "ready", "notes": "If the RGS committed a round before the interruption, the recovery fetch surfaces it and the resume path applies; otherwise the wager never left the balance and play restarts clean." },
    { "state": "outcome_received", "resumable": true, "resumeTo": "presenting_initial_result", "notes": "Manifest re-fetched from the server and re-verified; presentation starts from step 1." },
    { "state": "outcome_committed", "resumable": true, "resumeTo": "presenting_initial_result", "notes": "Committed manifest replayed from step 1." },
    { "state": "presenting_initial_result", "resumable": true, "resumeTo": "presenting_initial_result", "notes": "Seek presentation to resumePointer step instantly; render that step's grid, then continue remaining steps." },
    { "state": "presenting_wins", "resumable": true, "resumeTo": "presenting_wins", "notes": "Seek to resumePointer; win amounts come from the manifest, never recomputed." },
    { "state": "presenting_cascades", "resumable": true, "resumeTo": "presenting_cascades", "notes": "Render the resumePointer step's grid instantly and settle the identical total (GDD 6.1 recovery test)." },
    { "state": "feature_pending", "resumable": true, "resumeTo": "feature_pending", "notes": "Trigger already committed; tier entry replays from the manifest." },
    { "state": "feature_entry", "resumable": true, "resumeTo": "feature_active", "notes": "Entry presentation is skipped on resume; vial bank and spins-left restored from step ext fields." },
    { "state": "super_feature_entry", "resumable": true, "resumeTo": "super_feature_active", "notes": "As feature_entry, for The Distillery." },
    { "state": "ultimate_feature_entry", "resumable": true, "resumeTo": "ultimate_feature_active", "notes": "As feature_entry, for The Night Garden." },
    { "state": "feature_active", "resumable": true, "resumeTo": "feature_active", "notes": "multiplierBank, spinsLeft and retriggers restored from the step at resumePointer (ext.multiplierBank100 per GDD 6.2)." },
    { "state": "super_feature_active", "resumable": true, "resumeTo": "super_feature_active", "notes": "As feature_active." },
    { "state": "ultimate_feature_active", "resumable": true, "resumeTo": "ultimate_feature_active", "notes": "As feature_active; prisming events replay from steps, presentation-only." },
    { "state": "feature_retrigger", "resumable": true, "resumeTo": "feature_active", "notes": "Resumes into the tier-appropriate active state; the committed round state's tier field selects feature/super/ultimate via the tier_is_* guards." },
    { "state": "maximum_win", "resumable": true, "resumeTo": "feature_summary", "notes": "Cap already committed; summary shows cap reached, remaining rounds forfeited." },
    { "state": "feature_summary", "resumable": true, "resumeTo": "feature_summary", "notes": "Summary re-shown from committed totals." },
    { "state": "round_complete", "resumable": false, "resumeTo": "ready", "notes": "Round settled; nothing to replay." }
  ],
  "terminalStates": ["round_complete", "error"],
  "invalidTransitionPolicy": "recover",
  "presentationMap": {
    "boot": ["anim.system.boot"],
    "loading": ["anim.system.loading", "anim.system.loading_complete"],
    "ready": ["anim.system.idle"],
    "round_requested": ["anim.ui.spin_pressed", "anim.reel.spin_start"],
    "presenting_initial_result": ["anim.reel.drop", "anim.reel.stop", "anim.reel.quick_stop", "anim.reel.turbo_result", "anim.symbol.land", "anim.scatter.land", "anim.scatter.anticipation", "anim.orb.land"],
    "presenting_wins": ["anim.win.highlight", "anim.win.countup", "anim.win.countup_end", "anim.win.small", "anim.win.medium", "anim.win.big", "anim.win.mega", "anim.win.epic", "anim.orb.collect", "anim.orb.apply", "anim.hud.vial_update"],
    "presenting_cascades": ["anim.cascade.remove", "anim.cascade.refill", "anim.orb.land_refill"],
    "feature_pending": ["anim.feature.trigger", "anim.super_feature.trigger", "anim.ultimate_feature.trigger"],
    "feature_entry": ["anim.feature.enter"],
    "super_feature_entry": ["anim.super_feature.enter"],
    "ultimate_feature_entry": ["anim.ultimate_feature.enter"],
    "feature_active": ["anim.feature.round_start", "anim.hud.vial_update"],
    "super_feature_active": ["anim.super_feature.round_start", "anim.hud.vial_update"],
    "ultimate_feature_active": ["anim.ultimate_feature.round_start", "anim.ultimate_feature.prisming", "anim.hud.vial_update"],
    "feature_retrigger": ["anim.feature.retrigger"],
    "maximum_win": ["anim.maxwin.reached"],
    "feature_summary": ["anim.feature.summary", "anim.super_feature.summary", "anim.ultimate_feature.summary", "anim.feature.exit"],
    "reconnecting": ["anim.system.reconnect"],
    "recovering": ["anim.system.recover"],
    "error": ["anim.system.error"]
  },
  "audioMap": {
    "loading": ["amb.parlour"],
    "ready": ["music.base", "amb.parlour"],
    "round_requested": ["ui.click"],
    "presenting_initial_result": ["sfx.reel.stop", "sfx.symbol.land", "sfx.scatter.land", "sfx.scatter.anticipation", "sfx.orb.land"],
    "presenting_wins": ["sfx.win.small", "sfx.win.medium", "sfx.win.big", "sfx.win.mega", "sfx.win.epic", "sfx.orb.collect", "sfx.orb.apply"],
    "presenting_cascades": ["sfx.cascade.shatter", "sfx.cascade.settle"],
    "feature_pending": ["sfx.scatter.land", "sfx.scatter.anticipation"],
    "feature_entry": ["sfx.feature.enter", "music.feature"],
    "super_feature_entry": ["sfx.super_feature.enter", "music.super_feature"],
    "ultimate_feature_entry": ["sfx.ultimate_feature.enter", "music.ultimate_feature"],
    "feature_active": ["music.feature", "sfx.orb.collect", "sfx.orb.apply"],
    "super_feature_active": ["music.super_feature", "sfx.orb.collect", "sfx.orb.apply"],
    "ultimate_feature_active": ["music.ultimate_feature", "sfx.prisming.chime", "sfx.orb.collect", "sfx.orb.apply"],
    "feature_retrigger": ["sfx.feature.retrigger"],
    "maximum_win": ["sfx.maxwin.reached", "sfx.win.max"],
    "feature_summary": ["sfx.feature.summary"],
    "reconnecting": ["ui.reconnect"],
    "error": ["ui.error"]
  }
}
